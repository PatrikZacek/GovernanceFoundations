<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GovernancePackageVersion Condition="'$(GovernancePackageVersion)' == ''">0.1.0</GovernancePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Governance.Abstractions" Version="$(GovernancePackageVersion)" />
    <PackageReference Include="Governance.Core" Version="$(GovernancePackageVersion)" />
    <PackageReference Include="Governance.Persistence.Sqlite" Version="$(GovernancePackageVersion)" />
  </ItemGroup>
</Project>
